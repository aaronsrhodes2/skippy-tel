# Skippy Portal — environment. Copy to .env for local runs; on Cloud Run
# these are set with --set-env-vars / --set-secrets at deploy time instead.
# See docs/portal/README.md for how to get each value.

# Random 32+ char string. Rotate this to instantly invalidate every session.
FLASK_SECRET_KEY=

# Google Cloud Console → APIs & Services → Credentials → Create Credentials
# → OAuth client ID → Web application. Redirect URI: https://<host>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in. Comma-separated, case-insensitive.
ALLOWED_EMAILS=aaron.s.rhodes@gmail.com

# The games VM this portal controls (infra/gcp-games/).
GCP_PROJECT=skippy-tel
GCP_ZONE=us-west1-b
GCP_INSTANCE=skippy-games

# AI assistant tile. Point this at a specific Claude Project once the
# "Skippy" Project (docs/memory/README.md) exists, e.g.
# https://claude.ai/project/<id> — a bare new-chat link otherwise.
AI_ASSISTANT_URL=https://claude.ai/new
