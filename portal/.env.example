# Maker Portal — environment, for local runs only (copy to portal/.env).
# In production these are set by .github/workflows/deploy.yml: non-secrets
# with --set-env-vars, secrets from Secret Manager with --set-secrets.

FLASK_SECRET_KEY=                 # any long random string
SESSION_COOKIE_SECURE=false       # local http only; production is https
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=aaron.s.rhodes@gmail.com
ADMIN_EMAILS=aaron.s.rhodes@gmail.com
GCP_PROJECT=skippy-tel
GCP_ZONE=us-west1-b
GCP_INSTANCE=skippy-games
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5
DISCORD_INVITE=gPTVS7Hmj
DISCORD_BOT_TOKEN=
TELEMETRY_ENABLED=true            # record signed-in people's usage for the Captain (see /privacy); false switches it off
