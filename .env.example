# SkippyTel — environment.
# Copy to .env and fill in. .env is gitignored.

# ── Anthropic (heavy-hitter tier — fires only on "put on your thinking cap") ─
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Gemini (free-tier general chat — fires only on "ask gemini") ────────
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-flash-latest

# ── Ollama (default tier for /intent/unmatched) ──────────────────────────
# OLLAMA_BASE_URL is set in docker-compose.yml; only override if running
# flask-api outside Docker.
OLLAMA_MODEL=qwen2.5:7b

# ── Skippy persona / system prompt for escalations ───────────────────────
# Optional. Defaults to a terse AR-glasses-friendly prompt; override
# here if you want a different voice.
# SKIPPY_SYSTEM=You are Skippy...

# ── Whisper (faster-whisper) for /translate/audio ────────────────────────
# Multilingual model — required for translate task. Sizes: tiny, base,
# small, medium, large-v3. medium ~1.5GB, ~10-15s first-load on RTX 4070.
WHISPER_MODEL=medium

# ── InsightFace for /heybuddy/identify ───────────────────────────────────
INSIGHTFACE_MODEL=buffalo_l
# Cosine similarity threshold for a match. 0.40 = standard for buffalo_l;
# raise to ~0.50 for stricter matching, lower to ~0.30 for more permissive.
MATCH_THRESHOLD=0.40
