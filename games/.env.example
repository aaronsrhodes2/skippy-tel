# Copy to games/.env and fill in. games/.env is gitignored.

# Where world data lives. On the GCP VM this is the attached data disk.
DATA_DIR=./data
TZ=America/Los_Angeles

# ── Valheim ────────────────────────────────────────────────────────────────
VALHEIM_SERVER_NAME=Skippy Valheim
VALHEIM_WORLD_NAME=Skippy
VALHEIM_PASSWORD=change-me       # min 5 chars, must not contain the server name
VALHEIM_PUBLIC=false             # true = listed in the in-game server browser

# ── Factorio ───────────────────────────────────────────────────────────────
# Server password and name live in data/factorio/config/server-settings.json
# (created on first start). Set "game_password" there, then restart.
FACTORIO_SAVE_NAME=skippy

# ── Satisfactory ───────────────────────────────────────────────────────────
# First player to connect "claims" the server and sets the admin + join
# passwords in-game (Server Manager). Do that immediately after first boot.
SATISFACTORY_MAX_PLAYERS=4
SATISFACTORY_MEM_LIMIT=12g

# ── RuneScape: Dragonwilds ─────────────────────────────────────────────────
# OWNER_ID is your Dragonwilds *Player ID* (in-game Settings → bottom of the
# menu, copy button), not your Steam or Xbox ID. The server won't start without it.
# Players join by searching DRAGONWILDS_SERVER_NAME in the in-game server browser;
# DRAGONWILDS_WORLD_NAME only names the world created on the first boot.
DRAGONWILDS_OWNER_ID=
DRAGONWILDS_ADMIN_PASSWORD=change-me
DRAGONWILDS_SERVER_NAME=Skippy
DRAGONWILDS_WORLD_NAME=Ashenfall
DRAGONWILDS_WORLD_PASSWORD=      # empty = anyone who finds it can join
DRAGONWILDS_MAX_PLAYERS=6
DRAGONWILDS_PORT=7778
DRAGONWILDS_BEACON_PORT=8888     # world-settings beacon, udp

# ── Garry's Mod ────────────────────────────────────────────────────────────
# Players connect with `connect <ip>:27015` in the game console. A blank setting uses the default in brackets.
GARRYSMOD_SERVER_NAME=Skippy Garry's Mod
GARRYSMOD_PASSWORD=              # no spaces; empty = anyone who finds it can join
GARRYSMOD_GAMEMODE=              # (sandbox)
GARRYSMOD_MAP=                   # (gm_construct)
GARRYSMOD_MAX_PLAYERS=           # (16)
GARRYSMOD_WORKSHOP_COLLECTION=   # a Steam Workshop COLLECTION id: the server downloads it at every start

# ── Keeping servers and mods current (all optional; docs/games/MODS_AND_UPDATES.md) ──
# Blank means the default in brackets, which is what the servers did before these existed.
# VALHEIM_BEPINEX=                 # (false) true = BepInEx mods: plugins go in data/valheim/config/bepinex/plugins
# FACTORIO_VERSION=                # (stable) or latest, or an exact version such as 2.0.77 to hold the server
# FACTORIO_UPDATE_MODS=            # (false) true = update enabled mods on every start; needs the next two
# FACTORIO_USERNAME=               # your factorio.com username
# FACTORIO_TOKEN=                  # your factorio.com token: a secret
# FACTORIO_UPDATE_IGNORE=          # mod names, comma separated, never updated
# SATISFACTORY_SKIP_UPDATE=        # (false) true = keep the installed build
# DRAGONWILDS_UPDATE_ON_START=     # (true) leave on: the server must match the game client

# ── Discord (optional) ─────────────────────────────────────────────────────
# Filled in by `python scripts/discord_setup.py` (one text + voice channel per
# game, a webhook each, and a pinned status post). Treat webhook URLs like
# passwords: anyone with one can post to that channel.
# DISCORD_WEBHOOK_VALHEIM=      DISCORD_BOARD_VALHEIM=
# DISCORD_WEBHOOK_FACTORIO=     DISCORD_BOARD_FACTORIO=
# DISCORD_WEBHOOK_SATISFACTORY= DISCORD_BOARD_SATISFACTORY=
# DISCORD_WEBHOOK_DRAGONWILDS=  DISCORD_BOARD_DRAGONWILDS=
# DISCORD_WEBHOOK_GARRYSMOD=    DISCORD_BOARD_GARRYSMOD=
